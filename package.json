{
  "name": "belajar-tenun",
  "version": "0.3.0",
  "description": "BelajarTenun – AI-powered wearable weaving tutor (prototipe v0)",
  "type": "module",
  "scripts": {
    "build": "cd web && npm ci && npm run build",
    "web": "cd web && npm run dev",
    "start": "node server.js",
    "dev": "AUTH_DISABLED=1 node --watch server.js",
    "test": "node --test test/*.test.js",
    "evaluate": "node scripts/evaluate.js",
    "export-dataset": "node scripts/train/export_dataset.js",
    "livekit": "bash scripts/livekit/run.sh",
    "livekit:setup": "bash scripts/livekit/setup.sh",
    "agent": "python3 agent/main.py dev",
    "import-sources": "node scripts/import_sources.js",
    "import-motif": "node scripts/import_motif_dataset.js",
    "dialogs": "node scripts/generate_dialogs.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
