# ---- AI (wajib untuk deteksi kamera, Gemini Live, tanya jawab berbasis makna) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
GEMINI_EMBED_MODEL=gemini-embedding-001
# Opsional: suara Google TTS untuk mode standar (Gemini Live sudah punya suara sendiri)
GOOGLE_TTS_API_KEY=

# ---- LiveKit lokal + agen Gemini Live (docs/LIVEKIT.md) ----
# Kosongkan LIVEKIT_URL untuk memakai Gemini Live langsung dari browser.
LIVEKIT_URL=ws://localhost:7880
# Alamat yang dibuka HP/kacamata (pakai IP laptop di Wi-Fi yang sama, mis. ws://192.168.1.10:7880)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=belajartenun
LIVEKIT_API_SECRET=ganti-dengan-rahasia-panjang-minimal-32-karakter
# Rahasia bersama server ↔ agen Python (openssl rand -hex 24)
AGENT_TOKEN=
# Untuk agen: alamat server BelajarTenun
BT_SERVER=http://localhost:3000

# ---- Server ----
PORT=3000
# Lokal: ./data. Produksi: folder mount Cloud Storage (lihat docs/DEPLOY.md)
DATA_DIR=
# WAJIB di produksi: string acak panjang (openssl rand -hex 32)
AUTH_SECRET=
# Domain email yang partner-nya otomatis disetujui, pisahkan koma (opsional)
AUTO_APPROVE_DOMAINS=
# Produksi: 0 → tutor hanya memakai jawaban berstatus "tervalidasi"
KB_SERVE_DRAFT=1
# Simpan log maksimal N hari
RETENTION_DAYS=180
# Perkiraan biaya untuk dashboard admin (isi sesuai harga Gemini terbaru)
COST_PER_1K_INPUT_USD=0
COST_PER_1K_OUTPUT_USD=0
# HANYA untuk pengembangan lokal: semua orang dianggap admin
AUTH_DISABLED=0
