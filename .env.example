# ---- Domain produksi (deploy/docker-compose.yml): app di DOMAIN, LiveKit di livekit.DOMAIN ----
DOMAIN=

# ---- Masuk dengan Google (Google Cloud Console → APIs & Services → Credentials → OAuth client "Web application")
# Authorized redirect URI: https://DOMAIN/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Alamat publik app (default https://DOMAIN)
PUBLIC_URL=

# ---- AI: pilih SATU penyedia ----
# a) Vertex AI (disarankan untuk produksi). Simpan kunci service account di deploy/secrets/vertex-sa.json
#    (peran: Vertex AI User; tambah Storage Object Admin bila memakai VERTEX_GCS_BUCKET).
AI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Lokal tanpa Docker: path ke file service account
GOOGLE_APPLICATION_CREDENTIALS=
# Bucket Cloud Storage untuk analisis video sumber (pengganti Files API di Vertex)
VERTEX_GCS_BUCKET=
# b) Gemini API (AI Studio): isi key dan set AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Kosong = default per penyedia (Vertex: gemini-live-2.5-flash-native-audio)
GEMINI_LIVE_MODEL=
GEMINI_VOICE=Puck
GEMINI_EMBED_MODEL=gemini-embedding-001
# Opsional: suara Google TTS untuk mode standar (Gemini Live sudah punya suara sendiri)
GOOGLE_TTS_API_KEY=

# ---- LiveKit lokal + agen Gemini Live (docs/LIVEKIT.md) ----
# Kosongkan LIVEKIT_URL untuk memakai Gemini Live langsung dari browser.
LIVEKIT_URL=ws://localhost:7880
# Alamat yang dibuka HP/kacamata (pakai IP laptop di Wi-Fi yang sama, mis. ws://192.168.1.10:7880)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=belajartenun
LIVEKIT_API_SECRET=ganti-dengan-rahasia-panjang-minimal-32-karakter
# Rahasia bersama server ↔ agen Python (openssl rand -hex 24)
AGENT_TOKEN=
# Untuk agen: alamat server BelajarTenun
BT_SERVER=http://localhost:3000

# ---- Server ----
PORT=3000
# Lokal: ./data. Produksi: folder mount Cloud Storage (lihat docs/DEPLOY.md)
DATA_DIR=
# WAJIB di produksi: string acak panjang (openssl rand -hex 32)
AUTH_SECRET=
# Domain email yang partner-nya otomatis disetujui, pisahkan koma (opsional)
AUTO_APPROVE_DOMAINS=
# Produksi: 0 → tutor hanya memakai jawaban berstatus "tervalidasi"
KB_SERVE_DRAFT=1
# Simpan log maksimal N hari
RETENTION_DAYS=180
# Perkiraan biaya untuk dashboard admin (isi sesuai harga Gemini terbaru)
COST_PER_1K_INPUT_USD=0
COST_PER_1K_OUTPUT_USD=0
# HANYA untuk pengembangan lokal: semua orang dianggap admin
AUTH_DISABLED=0
